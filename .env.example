# MChat — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# ─── Database (Supabase PostgreSQL) ──────────────────────
# DATABASE_URL: ใช้สำหรับ runtime queries (connection pooler)
# ดูได้ที่ Supabase Dashboard → Settings → Database → Connection string → Transaction mode
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# DIRECT_URL: ใช้สำหรับ Prisma migrations เท่านั้น (prisma migrate dev / deploy)
# ดูได้ที่ Supabase Dashboard → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────
# สร้าง secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Development
NEXTAUTH_URL="http://localhost:3000"

# Production — ตั้งค่าใน Vercel Dashboard → Settings → Environment Variables
# NEXTAUTH_URL="https://mchat-git-main-vinit-deekhanu-s-projects.vercel.app"

# ─── OCR (ถ่ายรูปสลิป / บิล / ใบเสร็จ) — optional ──────
# ถ้าไม่มี key นี้ ปุ่มกล้องจะยังแสดงอยู่ แต่จะ return 503
# รับ key ได้ที่ https://platform.openai.com/api-keys
# model ที่ใช้: gpt-4o-mini (~0.004 บาท / รูป)
OPENAI_API_KEY=""

# ─── Admin ────────────────────────────────────────────────
# Email ของ admin — ถ้าไม่ตั้ง ทุกคนจะ 403 บน /api/admin/*
ADMIN_EMAIL="your-admin-email@example.com"

# ─── PromptPay (Payment) — optional ──────────────────────
# เบอร์ PromptPay ของเจ้าของระบบ (10 หลัก เช่น 0812345678)
# ใช้สร้าง QR code ในหน้า /pricing (manual flow)
PROMPTPAY_PHONE="0812345678"

# ─── Omise (Automated Payment) — optional ─────────────────
# รับ keys ได้ที่ https://dashboard.omise.co/settings/keys
# ถ้าไม่ตั้ง: หน้า /pricing จะแสดงเฉพาะ manual PromptPay
OMISE_SECRET_KEY="skey_test_..."    # server-side — สร้าง charge + ยืนยัน webhook
OMISE_PUBLIC_KEY="pkey_test_..."    # client-side — Omise.js บัตรเครดิต
# Webhook URL ที่ต้องตั้งใน Omise Dashboard → Webhooks:
# https://your-domain.vercel.app/api/webhooks/omise
OMISE_WEBHOOK_SECRET=""             # ดูได้จาก Omise Dashboard → Webhooks → Secret — ถ้าตั้งจะ verify signature

# ─── Stripe (Automated Payment — หลัก) — optional ─────────
# รับ keys ได้ที่ https://dashboard.stripe.com/apikeys
# ใช้ Stripe Checkout (redirect) รองรับบัตร + PromptPay สกุลเงิน THB
# ถ้าไม่ตั้ง: หน้า /pricing จะ fallback ไป manual PromptPay
STRIPE_SECRET_KEY="sk_test_..."      # server-side — สร้าง Checkout Session + verify webhook
# Webhook endpoint ที่ต้องตั้งใน Stripe Dashboard → Developers → Webhooks:
#   https://your-domain.vercel.app/api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET="whsec_..."    # Signing secret จาก Stripe Dashboard → Webhooks → endpoint

# ─── Email Verification (S08) — optional ─────────────────
# ใช้ Resend.com สำหรับส่งอีเมลยืนยันตัวตน
# รับ API key ได้ที่ https://resend.com/api-keys
# ถ้าไม่ตั้ง: ระบบจะ auto-verify อีเมลให้อัตโนมัติ (dev mode)
RESEND_API_KEY=""

# ─── Cron Secret (S12) — optional ────────────────────────
# ป้องกัน /api/cron/* ถูกเรียกโดยไม่ได้รับอนุญาต
# ตั้งใน Vercel Dashboard + ใส่ใน Vercel Cron → Environment
# สร้าง: openssl rand -base64 32
CRON_SECRET=""

# ─── Security ─────────────────────────────────────────────
# IP Allowlist สำหรับ /admin (S05) — comma-separated, ถ้าว่างจะ allow ทุก IP
# ADMIN_IP_ALLOWLIST="1.2.3.4,5.6.7.8"
